# Copy to .env and edit:  cp .env.example .env
# Loaded by setup_runpod.sh and runpod/start_gradio.sh (bash syntax, ${VAR} expansion works).

# ---------- Hugging Face ----------
# Optional for the public mucai/* checkpoints, but avoids rate limits. Needed for gated/private repos.
HF_TOKEN=
DATA_DIR=/workspace/data
HF_HOME=${DATA_DIR}/huggingface
HF_HUB_ENABLE_HF_TRANSFER=1

# ---------- Conda ----------
# Installed on the /workspace volume so it survives pod restarts.
CONDA_DIR=/workspace/miniconda3
CONDA_ENV_NAME=vip-llava
PYTHON_VERSION=3.10

# ---------- Models ----------
# Comma-separated HF repo ids or local paths; one model worker is started per entry.
# A6000 48GB: 7B fp16 ~15GB, 13B fp16 ~27GB (both together fit).
MODEL_PATHS=mucai/vip-llava-13b
# fp16 | 8bit | 4bit
LOAD_MODE=fp16

# ---------- Serving ----------
CONTROLLER_PORT=10000
WORKER_BASE_PORT=40000
GRADIO_PORT=7860
# 1 = create a public *.gradio.live link (valid 72h)
GRADIO_SHARE=1
GRADIO_ANALYTICS_ENABLED=False
LOG_DIR=${DATA_DIR}/logs
# Seconds to wait for each model worker to load (includes download if weights are missing)
WORKER_TIMEOUT=1800
